# Discord application/bot token (Developer Portal -> your app -> Bot -> Reset Token).
# This is the BOT's own credential, not a personal Discord account login.
DISCORD_BOT_TOKEN=

# Optional: your private server's ID. When set, slash commands sync to just
# that guild instantly. When unset, commands sync globally (can take ~1hr
# to appear everywhere the bot is installed).
DISCORD_GUILD_ID=

# Discord's per-file upload cap depends on your server's boost level:
#   no boost -> 25, level 2 boost -> 50, level 3 boost -> 100
DISCORD_UPLOAD_LIMIT_MB=25

# How many downloads can run at once bot-wide (protects your server's CPU/
# bandwidth and reduces the chance of a platform rate-limiting your IP).
MAX_CONCURRENT_DOWNLOADS=3

# Per-user cooldown (seconds) between /download uses.
COOLDOWN_SECONDS=15

# Hard ceiling (MB) on the source file yt-dlp is allowed to fetch, before
# any compression -- a safety net against filling the disk.
MAX_SOURCE_MB=500
